{
  "manifest_version": 3,
  "name": "Audio Volume Limiter",
  "version": "1.0.0",
  "description": "จำกัดระดับเสียงของแท็บไม่ให้ดังเกินค่า dB ที่คุณกำหนด กันเสียงโฆษณาและเอฟเฟกต์ดังกระทันหัน",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Audio Volume Limiter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-limiter": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "เปิด/ปิดการคุมเสียงในแท็บปัจจุบัน"
    }
  }
}
